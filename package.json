{
  "name": "feiyu-ui",
  "version": "0.1.0",
  "description": "Luminous Productivity UI Component Library - 糖果色调、毛玻璃质感、现代极简",
  "author": "Feiyu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hefy2027/feiyu-ui.git"
  },
  "homepage": "https://github.com/hefy2027/feiyu-ui#readme",
  "type": "module",
  "files": [
    "dist",
    "src",
    "styles"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.umd.js"
    },
    "./styles": "./dist/feiyu-ui.css",
    "./styles/*": "./styles/*"
  },
  "main": "./dist/index.umd.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "style": "./dist/feiyu-ui.css",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "sass": "^1.102.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.9"
  },
  "peerDependencies": {
    "vue": "^3.4.0 || ^3.5.0"
  },
  "keywords": [
    "vue3",
    "ui",
    "component",
    "components",
    "design-system",
    "luminous",
    "feiyu-ui"
  ]
}
